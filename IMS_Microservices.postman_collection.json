						"body": {
							"mode": "raw",
							"raw": "{\n    \"shipmentId\": \"SHIP-IMS-7001\",\n    \"supplier\": \"Global ScanTech Inc.\",\n    \"items\": [\n        {\n            \"sku\": \"PROD-IMS-001\",\n            \"expectedQuantity\": 50\n        }\n    ],\n    \"carrier\": \"DHL Express\"\n}"
