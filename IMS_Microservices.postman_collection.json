						"body": {
							"mode": "raw",
							"raw": "{\n    \"sku\": \"PROD-IMS-001\",\n    \"name\": \"Industrial Barcode Scanner\",\n    \"category\": \"Warehouse Hardware\",\n    \"price\": 299.99,\n    \"description\": \"High-speed wireless 2D barcode imager\"\n}"
